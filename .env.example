# OctoGemma Configuration
# ─────────────────────────────────────────────────────────────────
# Ollama Host & Port
# IMPORTANT: If you run OctoGemma alongside another AI tool that also
# uses Ollama (e.g., Antigravity IDE, Continue, Aider), they will
# compete for the same Ollama instance and may crash each other.
#
# To avoid conflicts, start a SECOND Ollama instance on a different
# port dedicated to OctoGemma:
#
#   Windows:  start_ollama_secondary.bat
#   Linux:    OLLAMA_HOST=127.0.0.1:11435 ollama serve
#
# Then set OLLAMA_BASE_URL below to point to the secondary instance.
# ─────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11435

# Primary Default Model (Google Gemma 4)
# Options: gemma4:e4b, gemma4:12b, gemma4:26b, gemma4:31b
# Fallback models: deepseek-coder-v2:16b-lite-instruct-q4_0, qwen3-coder:30b-a3b-q4_K_M
OCTOGEMMA_MODEL=gemma4:e4b

# Agent Settings
OCTOGEMMA_MAX_STEPS=25
OCTOGEMMA_TIMEOUT_SECONDS=120
OCTOGEMMA_WORKSPACE=.

# Web Server Settings
WEB_HOST=127.0.0.1
WEB_PORT=8000
